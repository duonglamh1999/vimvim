{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": ["eslint:recommended", "next/core-web-vitals"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "settings":{
    "react":{
      "version":"detect"
    }
  },
  "rules":{
    "no-unused-vars": "warn",
    "no-undef":"warn",
    "react/jsx-key":"off"
  }
}
